# DUO CAPITAL - Frontend (Vite). Copiez en « .env.local » si besoin. Ne mettez JAMAIS de secret ici :
# tout ce qui commence par VITE_ est visible dans le navigateur.

# Adresse de l'API. Laissez vide : le frontend appelle « /api/... » sur sa propre adresse
# (en développement, Vite relaie vers le backend ; en production, servez les deux sous le même domaine
# ou renseignez l'adresse de l'API, ex. https://api.exemple.com).
VITE_API_BASE_URL=

# Développement uniquement : adresse du backend vers laquelle Vite relaie « /api ».
VITE_DEV_API_TARGET=http://localhost:4000
