# DUO CAPITAL - API (backend)
# Copiez ce fichier en « .env » (jamais versionné) puis adaptez les valeurs.
# TOUTES les valeurs ci-dessous sont FICTIVES : aucun vrai mot de passe ni secret ici.

# Environnement : development | test | production
NODE_ENV=development

# Port d'écoute de l'API
PORT=4000

# Base de développement (ou de production quand NODE_ENV=production).
# MongoDB doit être un replica set pour les transactions (ex. « ?replicaSet=rs0 », voir README).
# Le nom de la base ne doit JAMAIS contenir le mot « test ».
DATABASE_URL=mongodb://127.0.0.1:27017/duo_capital_dev?replicaSet=rs0

# Base utilisée uniquement par les tests. Le nom DOIT contenir « test » et différer de DATABASE_URL.
# Facultatif : sans cette variable, `npm test` démarre une base MongoDB temporaire en mémoire.
TEST_DATABASE_URL=mongodb://127.0.0.1:27017/duo_capital_test?replicaSet=rs0

# Adresse(s) du frontend autorisée(s) par CORS (séparées par des virgules, sans « * »)
FRONTEND_URL=http://localhost:5173

# Niveau des journaux : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Authentification (B2) ---
# Secret de signature des JWT d'accès : OBLIGATOIRE, 32 caractères minimum, aléatoire, propre à chaque environnement.
# Générez-le ainsi (puis collez le résultat dans VOTRE .env, jamais ici) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# La valeur ci-dessous est un MODÈLE : le serveur refuse de démarrer si elle est laissée telle quelle.
JWT_ACCESS_SECRET=CHANGE_ME_generez_un_secret_aleatoire_de_48_octets

# Durée de vie du jeton d'accès (minutes, 1 à 60) et du refresh token (jours, 1 à 90)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# SameSite des cookies d'authentification : lax (frontend et API sur le même site, ex. localhost) | strict | none
# « none » (frontend et API sur des domaines différents) exige la production (cookies Secure, HTTPS).
COOKIE_SAME_SITE=lax

# --- Dashboard financier (Phase C) ---
# Mois de début du fonds (AAAA-MM), à renseigner pour calculer les cotisations ATTENDUES (15 000 FCFA par associé et par mois,
# à partir de ce mois jusqu'au mois en cours). Facultatif : sans lui, le dashboard n'invente aucun montant attendu
# et l'indique clairement ; les cotisations réellement versées restent affichées.
# FUND_START_PERIOD=2026-01
