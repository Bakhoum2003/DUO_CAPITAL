#

# Environnement : development | test | production
NODE_ENV=development

# Port d'écoute de l'API
PORT=4000


DATABASE_URL=mongodb://127.0.0.1:27017/duo_capital_dev?replicaSet=rs0


TEST_DATABASE_URL=mongodb://127.0.0.1:27017/duo_capital_test?replicaSet=rs0

FRONTEND_URL=http://localhost:5173

LOG_LEVEL=debug


JWT_ACCESS_SECRET=CHANGE_ME_generez_un_secret_aleatoire_de_48_octets

# Durée de vie du jeton d'accès (minutes, 1 à 60) et du refresh token (jours, 1 à 90)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7


COOKIE_SAME_SITE=lax

